{
  "name": "folio-job-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --names web,worker \"next dev --hostname 127.0.0.1 --port 3210\" \"npm run worker\"",
    "build": "next build",
    "start": "concurrently -k --names web,worker \"next start --hostname 127.0.0.1 --port 3210\" \"npm run worker\"",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
