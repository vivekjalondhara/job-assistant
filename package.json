{
  "name": "folio-job-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --names web,worker \"next dev --hostname 127.0.0.1 --port 3210\" \"npm run worker\"",
    "build": "next build",
    "start": "concurrently -k --names web,worker \"next start --hostname 127.0.0.1 --port 3210\" \"npm run worker\"",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "cloud:check": "tsx scripts/check-cloud.ts",
    "storage:cors": "tsx scripts/configure-storage-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
