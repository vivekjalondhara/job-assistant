# FOLIO CONFIGURATION
# Edit .env.local in the project root. Paste values after the equals signs.
# Blank optional values are intentional. Do not paste example labels as values.
# Keep .env.local private. The .env.example template contains no secrets.
# Restart the local app and worker after editing .env.local.
# For Vercel, use Project > Settings > Environment Variables, then redeploy.
# Cloud-only settings below require the still-pending Vercel migration.

# APPLICATION ADDRESS - used now.
# Local: http://localhost:3210
# Hosted: your exact HTTPS production address, without a trailing slash.
# Example format only: https://YOUR-PROJECT.vercel.app
APP_URL=http://localhost:3210

# LOCAL STORAGE - used now; keep this value for the local application.
# The planned Vercel version will use PostgreSQL and private Blob storage instead.
DATA_DIR=./data

# OPENROUTER API KEY - required for AI features; secret.
# Get it from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OPENROUTER MODEL ID - required for AI features; not a secret.
# Copy the exact provider/model ID from https://openrouter.ai/models
# Choose a model/provider supporting JSON schema output and zero-retention routing.
OPENROUTER_MODEL=

# OPENROUTER PROVIDERS - optional; leave blank unless restricting providers.
# If used, enter comma-separated provider slugs, not model IDs.
# The app always enforces zero-retention and no-collection provider filters.
OPENROUTER_PROVIDERS=

# GOOGLE CLIENT ID - required for Gmail; identifies your Google OAuth web client.
# Google Cloud > Google Auth Platform > Clients > Web application.
# Copy the complete Client ID, usually ending in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# GOOGLE CLIENT SECRET - required for Gmail; secret from the same OAuth client.
# This is not your Google password or an API key.
GOOGLE_CLIENT_SECRET=

# ALLOWED GOOGLE EMAIL - required for Gmail; your full Gmail/account address.
# Use this same account when connecting Gmail and in Google's test-user list.
GOOGLE_ALLOWED_EMAIL=

# GOOGLE REDIRECT URI - configure in Google Cloud, not as another env variable.
# Local: http://localhost:3210/api/auth/google/callback
# Hosted: https://YOUR-ACTUAL-DOMAIN/api/auth/google/callback
# The hosted domain must match APP_URL exactly.

# APP ENCRYPTION KEY - optional locally; a permanent secret is needed on Vercel.
# Leave blank for the existing local workspace: it uses DATA_DIR/.encryption-key.
# When migrating existing encrypted data, preserve that original key.
# For a NEW empty installation only, generate 32 random bytes as 64 hex characters:
#   openssl rand -hex 32
# Never replace this key on an existing installation or on each deployment.
APP_ENCRYPTION_KEY=

# CLOUD-ONLY SETTINGS - PLANNED, NOT IMPLEMENTED IN THE CURRENT APPLICATION
# You can fill these in preparation. They do not enable Vercel support by themselves.

# DATABASE URL - planned PostgreSQL connection string; secret.
# Obtain the pooled connection string from your connected Neon database.
# It contains the database username, password, host, database name, and SSL options.
DATABASE_URL=

# PRIVATE BLOB TOKEN - planned resume storage credential; secret.
# Create a PRIVATE Vercel Blob store and connect it to your project.
# Vercel supplies this token. Do not generate a substitute yourself.
BLOB_READ_WRITE_TOKEN=

# CRON SECRET - planned protection for scheduled-task endpoints; secret.
# Generate a different random value from APP_ENCRYPTION_KEY:
#   openssl rand -hex 32
# The future cron endpoint must validate this value before running tasks.
CRON_SECRET=
