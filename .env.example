# Copy to .env and fill the values. Do not commit .env.
# Vercel: add the same values in Project Settings > Environment Variables.
# Vercel does not receive your local .env through Git. Redeploy after changing settings.
APP_URL=http://localhost:3210

# Neon pooled PostgreSQL connection string, including its SSL options.
DATABASE_URL=

# Neon Object Storage (S3-compatible): create a PRIVATE bucket named assets.
# Get these four AWS_* values from your Neon branch's Object Storage connection panel.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=assets
S3_PREFIX=folio

# Permanent encryption key: openssl rand -hex 32
# Preserve this key after creating data. Replacing it makes saved encrypted data unreadable.
APP_ENCRYPTION_KEY=

# First-owner setup token: openssl rand -hex 32
# Enter this token on the first login page together with your chosen password.
# Later sign-ins need only the password. Use a different value from the encryption key.
APP_SETUP_TOKEN=

# Scheduled-job authentication: openssl rand -hex 32
# Vercel supplies this value in the Authorization header for /api/cron.
CRON_SECRET=

# Optional AI features.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDERS=

# Optional Gmail integration. Register APP_URL/api/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One address, or comma-separated addresses: first@gmail.com,second@gmail.com
# One mailbox is connected at a time. Both accounts must be OAuth test users while in Testing.
GOOGLE_ALLOWED_EMAIL=
