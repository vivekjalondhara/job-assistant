# Copy to .env.local. Never put these values in client-side variables.
APP_URL=http://localhost:3210
DATA_DIR=./data

# Optional until you enable AI generation. Choose a model that supports structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional comma-separated allowed provider slugs. ZDR and no-collection are always enforced.
OPENROUTER_PROVIDERS=

# Gmail OAuth web application credentials. Add this exact redirect URI in Google Cloud:
# http://localhost:3210/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAIL=

# Optional: use a stable 64-character hexadecimal encryption key in hosted deployments.
# If absent, a private key file is created inside DATA_DIR for this local installation.
APP_ENCRYPTION_KEY=
